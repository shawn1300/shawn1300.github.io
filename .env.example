# Supabase 项目配置
# 从 Supabase Dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key（仅服务端使用，绝不要暴露到客户端！）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 网站 URL
NEXT_PUBLIC_SITE_URL=https://shawn1300.cc.cd

# GitHub Personal Access Token（相册图片通过 GitHub API 上传）
# 需要 Contents 读写权限
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# DeepSeek 自动翻译（模型 ID 请以 DeepSeek 控制台为准）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash

# Vercel Cron 调用翻译接口时使用的随机长密钥
CRON_SECRET=replace-with-a-long-random-secret

# 可选：单次同步上限，避免超出 Vercel 函数时长或模型上下文
TRANSLATION_MAX_ITEMS=40
TRANSLATION_MAX_RUNTIME_MS=240000
TRANSLATION_BATCH_CHARACTERS=2000
TRANSLATION_BATCH_ITEMS=16
TRANSLATION_CONCURRENCY=2

# Komari 状态页（仅服务端读取）
# 私有站点填写面板级 API Key；公开站点可以留空。不要填写每台机器的 Agent Token。
KOMARI_BASE_URL=https://monitor.example.com
KOMARI_API_KEY=replace-with-a-komari-dashboard-api-key
KOMARI_NODES=[{"id":"11111111-1111-4111-8111-111111111111","name":"Oracle Phoenix","flag":"🇺🇸","location":"Phoenix","provider":"Oracle Cloud","os":"Ubuntu","arch":"amd64"}]
